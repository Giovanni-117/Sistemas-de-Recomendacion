---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/navbar.tsx";
import ListaCuponesCliente from "@/components/cupones/listaCuponesCliente.tsx";
import EncabezadoGeneral from "@/components/encabezadoGeneral.tsx";
import { verificarAutenticacionCliente } from "@/lib/auth/jwtCliente.ts";

const usuario = verificarAutenticacionCliente(Astro.request);
const autenticado = !!usuario;
---

<Layout>
  <EncabezadoGeneral client:load />

  {/* Lista de Cupones */}
  <main class="w-full max-w-lg mx-auto flex flex-col p-4 sm:p-6 pb-32">
    <ListaCuponesCliente client:load autenticado={autenticado} />
  </main>

  {/* Bottom Navigation Navbar */}
  <Navbar client:load />
</Layout>
