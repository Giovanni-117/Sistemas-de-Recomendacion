---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/navbar.tsx";
import EncabezadoGeneral from "@/components/encabezadoGeneral.tsx";
import BusquedaTesoroModal from "@/components/ganar/metodos/busquedaTesoroModal.tsx";
import PresumeYGanaModal from "@/components/ganar/metodos/presumeYGanaModal.tsx";
import RefiereYGanaModal from "@/components/ganar/metodos/refiereYGanaModal.tsx";
import BotonDinamicoGanar from "@/components/ganar/botonEstiloDinamicoGanar.tsx";

// ─── Guard de autenticación ──────────────────────────────────────────────────

const COLORS = [
  "#FBBF24",
  "#F472B6",
  "#A3E635",
  "#22D3EE",
  "#C084FC",
  "#FB923C",
  "#F87171",
];
const PATTERNS = [
  "radial-gradient(circle at center, #000 2px, transparent 2px)",
  "linear-gradient(45deg, #000 25%, transparent 25%, transparent 50%, #000 50%, #000 75%, transparent 75%, transparent)",
  "linear-gradient(90deg, #000 3px, transparent 3px), linear-gradient(0deg, #000 3px, transparent 3px)",
  "radial-gradient(circle at center, #000 4px, transparent 4px)",
  "repeating-radial-gradient(circle at 0 0, transparent 0, #000 2px, transparent 3px, transparent 100%)",
];
const PATTERN_SIZES = [
  "24px 24px",
  "32px 32px",
  "20px 20px",
  "16px 16px",
  "32px 32px",
];

// Barajamos para asegurar combinaciones únicas
const shuffledColors = [...COLORS].sort(() => 0.5 - Math.random());
const shuffledIndices = [...Array(PATTERNS.length).keys()].sort(
  () => 0.5 - Math.random()
);

const configs = [0, 1, 2].map((i) => ({
  color: shuffledColors[i],
  pattern: PATTERNS[shuffledIndices[i]],
  patternSize: PATTERN_SIZES[shuffledIndices[i]],
}));
---

<Layout>
  <EncabezadoGeneral client:load />
  {/* Contenedor principal centrado con tarjetas cuadradas */}
  <main
    class="min-h-[calc(100vh-6rem)] w-full max-w-lg mx-auto flex flex-col justify-center items-center p-4 sm:p-6 pb-[120px] sm:pb-[140px]"
  >
    <div class="w-full grid grid-cols-2 gap-4 sm:gap-6">
      {/* Botón 1: Búsqueda del Tesoro */}
      <BotonDinamicoGanar
        client:load
        id="btn-tesoro"
        label="¡Busca!"
        modalId="modal_tesoro"
        zIndex={30}
        delay="0s"
        color={configs[0].color}
        pattern={configs[0].pattern}
        patternSize={configs[0].patternSize}
      >
        <svg
          class="w-20 h-20 sm:w-28 sm:h-28 drop-shadow-[3px_3px_0px_rgba(0,0,0,1)]"
          viewBox="0 0 24 24"
          fill="white"
          stroke="black"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"
          ></path>
          <path d="M15 5.764v15"></path>
          <path d="M9 3.236v15"></path>
          <circle cx="12" cy="12" r="2.5" fill="black"></circle>
        </svg>
      </BotonDinamicoGanar>

      {/* Botón 2: Presume y Gana */}
      <BotonDinamicoGanar
        client:load
        id="btn-presume"
        label="¡Presume!"
        modalId="modal_presume"
        zIndex={20}
        delay="0.3s"
        color={configs[1].color}
        pattern={configs[1].pattern}
        patternSize={configs[1].patternSize}
      >
        <svg
          class="w-20 h-20 sm:w-28 sm:h-28 drop-shadow-[3px_3px_0px_rgba(0,0,0,1)]"
          viewBox="0 0 24 24"
          fill="white"
          stroke="black"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"
          ></path>
          <circle cx="12" cy="13" r="3" fill="black"></circle>
        </svg>
      </BotonDinamicoGanar>

      {/* Botón 3: Refiere y Gana */}
      <BotonDinamicoGanar
        client:load
        id="btn-refiere"
        label="¡Refiere!"
        modalId="modal_refiere"
        zIndex={10}
        delay="0.6s"
        color={configs[2].color}
        pattern={configs[2].pattern}
        patternSize={configs[2].patternSize}
      >
        <svg
          class="w-20 h-20 sm:w-28 sm:h-28 drop-shadow-[3px_3px_0px_rgba(0,0,0,1)]"
          viewBox="0 0 24 24"
          fill="white"
          stroke="black"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4" fill="black"></circle>
          <path d="M19 8v6"></path>
          <path d="M22 11h-6"></path>
        </svg>
      </BotonDinamicoGanar>

      {/* Tarjeta 4: Próximamente */}
      <div
        class="w-full aspect-square bg-slate-200 border-[4px] border-black border-dashed rounded-3xl flex flex-col items-center justify-center p-3 text-center overflow-hidden relative opacity-90"
      >
        <div
          class="absolute inset-0 opacity-5 bg-[linear-gradient(45deg,_#000_25%,_transparent_25%,_transparent_50%,_#000_50%,_#000_75%,_transparent_75%,_transparent)] bg-[size:16px_16px] pointer-events-none"
        >
        </div>
        <div class="flex-1 flex items-center justify-center mt-1">
          <span class="text-[clamp(1.5rem,8vw,2.25rem)] sm:text-4xl drop-shadow-md animate-[pulse_3s_infinite]"
            >⏳</span
          >
        </div>
        <span
          class="font-extrabold text-[clamp(12px,4.5vw,22px)] sm:text-xl uppercase tracking-tight text-slate-700 leading-tight pb-1"
          >¡Más formas <br /> muy pronto!</span
        >
      </div>
    </div>
  </main>

  {
    /* Modals encapsulados como componentes de React que abren nativamente con DaisyUI */
  }
  <BusquedaTesoroModal client:load />
  <PresumeYGanaModal client:load />
  <RefiereYGanaModal client:load />

  {/* Bottom Navigation Navbar */}
  <Navbar client:load />

  <style is:global>
    /* Micro animaciones estilo Wario Ware: Errácticas y divertidas */
    @keyframes squish-gentle {
      0%,
      100% {
        transform: scale(1, 1);
      }
      50% {
        transform: scale(0.98, 1.02);
      }
    }

    .wario-btn-squish {
      /* Se usa una animación mucho más suave y lenta, con un delay escalonado */
      animation: squish-gentle 2s ease-in-out infinite;
      transform-origin: bottom;
    }

    /* Stroke para que el texto resalte muchísimo */
    .stroke-text-black {
      -webkit-text-stroke: 2px black;
    }

    /* Pausar animaciones al interactuar o hacer hover para facilitar el clic */
    .wario-btn-squish:hover,
    .wario-btn-squish:active {
      animation-play-state: paused;
    }
  </style>
</Layout>
