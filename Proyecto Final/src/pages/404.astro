---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <main class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden bg-base-100 text-base-content selection:bg-primary/30 py-20">
    <!-- Dynamic Background Elements for an artistic atmosphere -->
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center overflow-hidden">
      <!-- Soft ambient glows -->
      <div class="absolute h-[60vh] w-[60vw] rounded-full bg-primary/5 blur-[150px] opacity-70 animate-pulse mix-blend-multiply" style="animation-duration: 10s;"></div>
      <div class="absolute -top-[10%] -right-[5%] h-[500px] w-[500px] rounded-full bg-secondary/10 blur-[120px] mix-blend-multiply"></div>
      <div class="absolute -bottom-[10%] -left-[5%] h-[500px] w-[500px] rounded-full bg-accent/10 blur-[120px] mix-blend-multiply"></div>
    </div>

    <!-- Canvas Noise overlay to give it a painted/premium texture -->
    <div class="pointer-events-none absolute inset-0 opacity-[0.04]" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>

    <!-- Main Artistic Content -->
    <div class="relative z-10 w-full max-w-4xl px-6 text-center flex flex-col items-center justify-center">
      
      <!-- Artistic Compass Icon (Replacing the technical '404') -->
      <div class="relative flex justify-center items-center w-28 h-28 mb-8 group">
        <!-- Glowing aura -->
        <div class="absolute inset-0 bg-primary/20 rounded-full blur-2xl animate-pulse group-hover:bg-primary/40 transition-colors duration-700"></div>
        <div class="absolute inset-0 bg-accent/20 rounded-full blur-xl scale-75 animate-spin-slow" style="animation-duration: 15s;"></div>
        <!-- Compass SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary relative z-10 transform transition-transform duration-700 group-hover:rotate-180 drop-shadow-[0_0_15px_rgba(var(--primary-rgb),0.5)]">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
      </div>

      <!-- Human-friendly message -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-base-content mb-6 drop-shadow-sm">
        ¡Uy, te saliste del mapa!
      </h1>
      <p class="text-lg sm:text-xl text-base-content/70 font-medium max-w-2xl mb-12">
        Parece que llegaste a un rincón vacío. No te preocupes.
      </p>

      <!-- The Bomba - Presented as an artistic quote card -->
      <div class="relative w-full max-w-2xl group perspective-1000 mt-4">
        <!-- Painted shadow effect -->
        <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-primary/20 via-transparent to-accent/20 opacity-40 blur-2xl transition-all duration-700 group-hover:opacity-70 group-hover:blur-3xl"></div>
        
        <div class="relative rounded-[2rem] bg-base-100/40 backdrop-blur-2xl border border-white/10 p-10 sm:p-14 shadow-2xl flex flex-col items-center transform transition-transform duration-700 group-hover:-translate-y-2">
          
          <!-- Elegant Quotes Icon -->
          <div class="absolute top-8 left-8 opacity-10 text-primary pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="currentColor">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
          </div>

          
        </div>
      </div>

      <!-- Friendly Call to Action -->
      <div class="mt-16 relative group">
        <div class="absolute -inset-1 rounded-full bg-gradient-to-r from-primary to-accent opacity-30 blur-lg transition duration-500 group-hover:opacity-60 group-hover:duration-200"></div>
        
        <a href="/" class="relative flex items-center justify-center gap-3 rounded-full bg-base-content px-10 py-5 text-base-100 font-extrabold text-lg transition-all duration-300 hover:scale-105 shadow-xl border border-transparent hover:border-white/10">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1.5 transition-transform duration-300">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Llévame al inicio
        </a>
      </div>

    </div>
  </main>
</Layout>
